scale_x_continuous(breaks = seq(1, 12, 1),
labels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
expand = expansion(mult = 0.01, add = 0)) +
